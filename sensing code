#include <ESP8266WiFi.h>
#include <DHT.h>       // Include the DHT library
#include <MQ135.h>     // Include the MQ135 library
#include <Wire.h>      // Include Wire library for I2C communication
#include <BMP280.h>    // Include Bosch BMP280 library for actual sensor

// WiFi credentials
const char* ssid = "maaz";
const char* password = "maazsyed1234";

// ThingSpeak settings
String apiKey = "23TS9M4YJN9JWF4Q";
const char* server = "api.thingspeak.com";

// Pin definitions
#define DHTPIN D2       // Digital pin connected to the DHT sensor (change as needed)
#define MQ135PIN A0     // Analog pin connected to the MQ135 sensor
#define BMP_SDA D3      // BMP280 SDA pin
#define BMP_SCL D4      // BMP280 SCL pin

// Sensor types and initialization
DHT dht(DHTPIN, DHT22);         // Initialize DHT sensor
MQ135 mq135(MQ135PIN);          // Initialize MQ135 sensor
BMP280 bmp;                     // Initialize Bosch BMP280 sensor

WiFiClient client;  // Initialize WiFi client object

void setup() {
    Serial.begin(9600);
    WiFi.begin(ssid, password);
    Serial.print("Connecting to WiFi...");

    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }

    Serial.println("WiFi connected.");
    Serial.print("NodeMCU IP Address: ");
    Serial.println(WiFi.localIP());

    dht.begin(); // Initialize DHT sensor

    // Initialize BMP280 sensor
    Wire.begin(BMP_SDA, BMP_SCL);
    bmp.begin();
}

void loop() {
    // Check WiFi connection
    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("WiFi not connected!");
        delay(2000);
        return;
    }

    // Read DHT22 sensor data
    float temperature = dht.readTemperature(); // Read temperature as Celsius
    float humidity = dht.readHumidity();       // Read humidity

    // Read MQ135 sensor data
    float ppm = mq135.getPPM();

    // Read BMP280 sensor data
    float pressure = bmp.readPressure() / 100.0F; // Convert pressure to hPa

    // Check if any reads failed and exit early (to try again).
    if (isnan(temperature) || isnan(humidity)) {
        Serial.println("Failed to read from DHT sensor!");
        delay(2000); // Wait for a few seconds before retrying
        return;
    }

    // Print sensor data to serial monitor
    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.print(" °C\tHumidity: ");
    Serial.print(humidity);
    Serial.println(" %");
    Serial.print("Gas Concentration: ");
    Serial.print(ppm);
    Serial.println(" ppm");
    Serial.print("Pressure: ");
    Serial.print(pressure);
    Serial.println(" hPa");

    // Send data to ThingSpeak
    if (!client.connected() && !client.connect(server, 80)) {
        Serial.println("Failed to connect to ThingSpeak!");
        return;
    }

    String postStr = apiKey;
    postStr += "&field1=";
    postStr += String(temperature);  // Field 1 for temperature
    postStr += "&field2=";
    postStr += String(humidity);     // Field 2 for humidity
    postStr += "&field3=";
    postStr += String(ppm);          // Field 3 for gas concentration
    postStr += "&field4=";
    postStr += String(pressure);     // Field 4 for pressure
    postStr += "\r\n\r\n";

    client.print("POST /update HTTP/1.1\n");
    client.print("Host: api.thingspeak.com\n");
    client.print("Connection: close\n");
    client.print("X-THINGSPEAKAPIKEY: " + apiKey + "\n");
    client.print("Content-Type: application/x-www-form-urlencoded\n");
    client.print("Content-Length: ");
    client.print(postStr.length());
    client.print("\n\n");
    client.print(postStr);

    delay(1000); // Necessary delay for posting to ThingSpeak

    Serial.println("Data sent to ThingSpeak");

    client.stop();

    Serial.println("Waiting for 15 seconds...");
    delay(15000); // ThingSpeak requires at least 15 seconds delay between updates
}
